{
  "name": "@lulu/vue",
  "version": "0.1.0",
  "description": "Vue 3 components inspired by LuLu UI Edge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/lulu-for-vue.git",
    "directory": "packages/ui"
  },
  "homepage": "https://bosens-china.github.io/lulu-for-vue/",
  "bugs": {
    "url": "https://github.com/bosens-China/lulu-for-vue/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./base.css": "./dist/styles/base.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/entries/*.js"
    },
    "./button/style.css": "./dist/styles/components/button.css",
    "./space/style.css": "./dist/styles/components/space.css",
    "./data-table/style.css": "./dist/styles/components/data-table.css",
    "./table/style.css": "./dist/styles/components/table.css",
    "./field-error/style.css": "./dist/styles/components/field-error.css",
    "./loading/style.css": "./dist/styles/components/loading.css",
    "./loading-overlay/style.css": "./dist/styles/components/loading-overlay.css",
    "./message/style.css": "./dist/styles/components/message.css",
    "./message-host/style.css": "./dist/styles/components/message-host.css",
    "./progress/style.css": "./dist/styles/components/progress.css",
    "./autocomplete/style.css": "./dist/styles/components/autocomplete.css",
    "./checkbox/style.css": "./dist/styles/components/checkbox.css",
    "./color-picker/style.css": "./dist/styles/components/color-picker.css",
    "./date-picker/style.css": "./dist/styles/components/date-picker.css",
    "./date-range-picker/style.css": "./dist/styles/components/date-range-picker.css",
    "./form/style.css": "./dist/styles/components/form.css",
    "./form-field/style.css": "./dist/styles/components/form-field.css",
    "./hour-picker/style.css": "./dist/styles/components/hour-picker.css",
    "./input/style.css": "./dist/styles/components/input.css",
    "./radio/style.css": "./dist/styles/components/radio.css",
    "./range-slider/style.css": "./dist/styles/components/range-slider.css",
    "./rate/style.css": "./dist/styles/components/rate.css",
    "./select/style.css": "./dist/styles/components/select.css",
    "./slider/style.css": "./dist/styles/components/slider.css",
    "./switch/style.css": "./dist/styles/components/switch.css",
    "./textarea/style.css": "./dist/styles/components/textarea.css",
    "./year-picker/style.css": "./dist/styles/components/year-picker.css",
    "./accordion/style.css": "./dist/styles/components/accordion.css",
    "./disclosure/style.css": "./dist/styles/components/disclosure.css",
    "./tab/style.css": "./dist/styles/components/tab.css",
    "./tab-panel/style.css": "./dist/styles/components/tab-panel.css",
    "./tabs/style.css": "./dist/styles/components/tabs.css",
    "./pagination/style.css": "./dist/styles/components/pagination.css",
    "./dialog/style.css": "./dist/styles/components/dialog.css",
    "./dialog-host/style.css": "./dist/styles/components/dialog-host.css",
    "./dropdown/style.css": "./dist/styles/components/dropdown.css",
    "./popconfirm/style.css": "./dist/styles/components/popconfirm.css",
    "./popover/style.css": "./dist/styles/components/popover.css",
    "./tooltip/style.css": "./dist/styles/components/tooltip.css"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.2.0",
    "@unocss/cli": "^66.7.5",
    "typescript": "^6.0.3",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.0"
  },
  "scripts": {
    "build": "unocss \"src/components/**/*.vue\" -c uno.config.ts -o .generated/uno.css && tsdown",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs"
  }
}
